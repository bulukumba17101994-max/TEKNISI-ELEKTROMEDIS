{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated hospital user profile linked to Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified user email address",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "description": "User full display name",
          "minLength": 1,
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "description": "Application access role",
          "enum": ["admin", "user"]
        },
        "teknisiUsername": {
          "type": "string",
          "description": "Mapped technician username if applicable",
          "maxLength": 64
        },
        "ruangan": {
          "type": "string",
          "description": "Assigned hospital room or unit",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized biomedical technician administrator record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Administrator verified email",
          "maxLength": 200
        },
        "namaLengkap": {
          "type": "string",
          "description": "Administrator full name",
          "minLength": 1,
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": ["uid", "email", "namaLengkap", "createdAt"]
    },
    "Alkes": {
      "title": "Alkes",
      "description": "Medical equipment inventory item at RSUD Lamaddukelleng.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique equipment identifier",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ruangan": {
          "type": "string",
          "description": "Hospital room where equipment is located",
          "minLength": 1,
          "maxLength": 100
        },
        "namaAlat": {
          "type": "string",
          "description": "Medical equipment name",
          "minLength": 1,
          "maxLength": 200
        },
        "merk": {
          "type": "string",
          "description": "Equipment brand or manufacturer",
          "maxLength": 150
        },
        "modelType": {
          "type": "string",
          "description": "Equipment model or type",
          "maxLength": 150
        },
        "serialNumber": {
          "type": "string",
          "description": "Equipment serial number",
          "maxLength": 150
        },
        "tahunPengadaan": {
          "type": "string",
          "description": "Procurement year",
          "maxLength": 32
        },
        "kalibrasiTerakhir": {
          "type": "string",
          "description": "Last calibration date YYYY-MM-DD",
          "maxLength": 32
        },
        "kalibrasiBerikutnya": {
          "type": "string",
          "description": "Next calibration date YYYY-MM-DD",
          "maxLength": 32
        },
        "statusKalibrasi": {
          "type": "string",
          "description": "Calibration status",
          "enum": ["Terkalibrasi", "Perlu Kalibrasi", "Kadaluarsa"]
        },
        "kondisi": {
          "type": "string",
          "description": "Physical condition of equipment",
          "enum": ["Baik", "Rusak Ringan", "Rusak Sedang", "Rusak Berat"]
        },
        "keterangan": {
          "type": "string",
          "description": "Operational remarks",
          "maxLength": 200
        },
        "nomorInventaris": {
          "type": "string",
          "description": "Hospital asset inventory number",
          "maxLength": 120
        },
        "lokasiSpesifik": {
          "type": "string",
          "description": "Specific location inside room",
          "maxLength": 150
        },
        "lastEditedBy": {
          "type": "string",
          "description": "Name of technician who last edited the record",
          "maxLength": 150
        },
        "ownerId": {
          "type": "string",
          "description": "Creator Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": [
        "id",
        "ruangan",
        "namaAlat",
        "merk",
        "modelType",
        "serialNumber",
        "tahunPengadaan",
        "statusKalibrasi",
        "kondisi",
        "keterangan",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "Pemeliharaan": {
      "title": "Pemeliharaan",
      "description": "Preventive maintenance (PPM) inspection log for medical equipment.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique maintenance record ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tanggal": {
          "type": "string",
          "description": "Maintenance date YYYY-MM-DD",
          "minLength": 1,
          "maxLength": 32
        },
        "namaTeknisi": {
          "type": "string",
          "description": "Technician name",
          "minLength": 1,
          "maxLength": 150
        },
        "nipTeknisi": {
          "type": "string",
          "description": "Technician employee ID",
          "maxLength": 64
        },
        "ruangan": {
          "type": "string",
          "description": "Hospital room",
          "minLength": 1,
          "maxLength": 100
        },
        "alkesId": {
          "type": "string",
          "description": "Optional linked Alkes document ID",
          "maxLength": 128
        },
        "namaAlat": {
          "type": "string",
          "description": "Equipment name",
          "minLength": 1,
          "maxLength": 200
        },
        "merk": {
          "type": "string",
          "description": "Equipment brand",
          "maxLength": 150
        },
        "modelType": {
          "type": "string",
          "description": "Equipment model",
          "maxLength": 150
        },
        "serialNumber": {
          "type": "string",
          "description": "Serial number",
          "maxLength": 150
        },
        "kegiatanFisik": {
          "type": "boolean",
          "description": "Physical and accessories inspection completed"
        },
        "kegiatanSetting": {
          "type": "boolean",
          "description": "Parameter setting and electrical/mechanical maintenance completed"
        },
        "kegiatanCleaning": {
          "type": "boolean",
          "description": "Equipment cleaning completed"
        },
        "kondisi": {
          "type": "string",
          "description": "Equipment condition after maintenance",
          "enum": ["Baik", "Rusak Ringan", "Rusak Sedang", "Rusak Berat"]
        },
        "status": {
          "type": "string",
          "description": "Feasibility status",
          "enum": ["layak pakai", "perlu perbaikan / penggantian sparepart"]
        },
        "catatan": {
          "type": "string",
          "description": "Technician notes",
          "maxLength": 1000
        },
        "rekomendasi": {
          "type": "string",
          "description": "Technician recommendations",
          "maxLength": 1000
        },
        "ownerId": {
          "type": "string",
          "description": "Creator Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "tanggal",
        "namaTeknisi",
        "ruangan",
        "namaAlat",
        "kegiatanFisik",
        "kegiatanSetting",
        "kegiatanCleaning",
        "kondisi",
        "status",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "Perbaikan": {
