  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Private user profiles keyed by Firebase Auth UID."
    },
    "/admins/{userId}": {
      "schema": {
        "$ref": "#/entities/Admin"
      },
      "description": "Administrator registry keyed by Firebase Auth UID."
    },
    "/alkes/{alkesId}": {
      "schema": {
        "$ref": "#/entities/Alkes"
      },
      "description": "Hospital medical equipment inventory records."
    },
    "/pemeliharaan/{pemeliharaanId}": {
      "schema": {
        "$ref": "#/entities/Pemeliharaan"
      },
      "description": "Preventive maintenance (PPM) inspection records."
    },
    "/perbaikan/{perbaikanId}": {
      "schema": {
        "$ref": "#/entities/Perbaikan"
      },
      "description": "Corrective repair work orders (SPK) and damage reports."
    },
    "/perbaikan/{perbaikanId}/comments/{commentId}": {
      "schema": {
        "$ref": "#/entities/PerbaikanComment"
      },
      "description": "Discussion thread comments attached to a repair work order."
    },
    "/beritaAcara/{bapId}": {
      "schema": {
        "$ref": "#/entities/BeritaAcara"
      },
      "description": "Official medical equipment withdrawal reports (BAP)."
    },
    "/ruangan/{ruanganId}": {
      "schema": {
        "$ref": "#/entities/Ruangan"
      },
      "description": "Master list of hospital rooms and units."
    },
    "/systemConfig/{configId}": {
      "schema": {
        "$ref": "#/entities/SystemConfig"
      },
      "description": "System integration settings for Google Sheets and email alerts."
    }
  }
}
