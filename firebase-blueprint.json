        "ownerId": {
          "type": "string",
          "description": "Creator Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "nomorSpk",
        "tanggal",
        "pelapor",
        "ruangan",
        "namaAlat",
        "keluhanKerusakan",
        "statusPerbaikan",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
